rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection (Patients, Doctors, Admins)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Departments collection (Cardiology, Orthopedics, Pediatrics, etc.)
    match /departments/{deptId} {
      allow read, write: if true;
    }

    // Doctors directory
    match /doctors/{doctorId} {
      allow read, write: if true;
    }

    // Appointments collection (Tokens, bookings, consultation status)
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Daily queues collection (Real-time live queue counter & turn tracker)
    match /daily_queues/{queueId} {
      allow read, write: if true;
    }
  }
}
