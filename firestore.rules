rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Hospitals: Anyone can read, authenticated admin can manage
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Departments: Anyone can read (OPD public directory)
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Doctors: Anyone can read public availability & OPD status
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Users: Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Appointments: Token bookings, consultation status
    match /appointments/{appointmentId} {
      allow read, write: if isAuthenticated();
    }

    // Daily Queues: Live token counter, turn tracker, break notices
    match /daily_queues/{queueId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Notifications: 1-hour, 30-min reminders, call alerts, break notices
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }
  }
}
